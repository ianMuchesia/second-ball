{
  "$defs": {
    "Clock": {
      "additionalProperties": false,
      "properties": {
        "minute": {
          "minimum": 0,
          "type": "integer"
        },
        "period": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "second": {
          "maximum": 59,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "period",
        "minute",
        "second"
      ],
      "title": "Clock",
      "type": "object"
    },
    "Insight": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "minLength": 1,
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "evidence_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "mechanism": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "claim",
        "mechanism",
        "evidence_event_ids",
        "confidence"
      ],
      "title": "Insight",
      "type": "object"
    },
    "LineupPlayer": {
      "additionalProperties": false,
      "description": "One player on the published team sheet (public before kick-off).",
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "enum": [
            "GK",
            "RB",
            "RCB",
            "CB",
            "LCB",
            "LB",
            "RWB",
            "LWB",
            "DM",
            "RCM",
            "CM",
            "LCM",
            "RM",
            "LM",
            "AM",
            "RW",
            "LW",
            "ST"
          ],
          "type": "string"
        },
        "shirt_number": {
          "maximum": 99,
          "minimum": 1,
          "type": "integer"
        },
        "starting": {
          "default": true,
          "type": "boolean"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "sweeper keeper",
                "ball-playing centre-back",
                "stopper",
                "inverted full-back",
                "overlapping full-back",
                "wing-back",
                "deep-lying playmaker",
                "holding midfielder",
                "box-to-box midfielder",
                "attacking midfielder",
                "inverted winger",
                "touchline winger",
                "poacher",
                "target man",
                "false 9",
                "creative 9",
                "second striker"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "team_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "player_id",
        "team_id",
        "name",
        "shirt_number",
        "position"
      ],
      "title": "LineupPlayer",
      "type": "object"
    },
    "Match": {
      "additionalProperties": false,
      "properties": {
        "away_strength": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "away_team": {
          "minLength": 1,
          "type": "string"
        },
        "competition": {
          "minLength": 1,
          "type": "string"
        },
        "home_strength": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "home_team": {
          "minLength": 1,
          "type": "string"
        },
        "kickoff": {
          "format": "date-time",
          "type": "string"
        },
        "lineups": {
          "items": {
            "$ref": "#/$defs/LineupPlayer"
          },
          "type": "array"
        },
        "match_id": {
          "minLength": 1,
          "type": "string"
        },
        "mode": {
          "enum": [
            "scenario",
            "free_simulation"
          ],
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "type": "integer"
        },
        "venue": {
          "minLength": 1,
          "type": "string"
        },
        "weather": {
          "enum": [
            "dry",
            "rain",
            "wind",
            "heat"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "match_id",
        "home_team",
        "away_team",
        "venue",
        "kickoff",
        "competition",
        "seed",
        "weather",
        "mode",
        "home_strength",
        "away_strength",
        "lineups"
      ],
      "title": "Match",
      "type": "object"
    },
    "MatchEvent": {
      "additionalProperties": false,
      "description": "SPADL convention: coordinates are from the acting team's view, so it attacks\ntowards x=105 and its own goal is at x=0.",
      "properties": {
        "ball_speed_kmh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body_part": {
          "enum": [
            "foot",
            "foot_left",
            "foot_right",
            "head",
            "other"
          ],
          "type": "string"
        },
        "end_x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "end_y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        "event_id": {
          "minLength": 1,
          "type": "string"
        },
        "freeze_frame": {
          "items": {
            "$ref": "#/$defs/PlayerPosition"
          },
          "maxItems": 22,
          "minItems": 1,
          "type": "array"
        },
        "match_id": {
          "minLength": 1,
          "type": "string"
        },
        "minute": {
          "minimum": 0,
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "success",
            "fail",
            "offside",
            "owngoal",
            "yellow_card",
            "red_card"
          ],
          "type": "string"
        },
        "period": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "player_id": {
          "minLength": 1,
          "type": "string"
        },
        "possession_id": {
          "minLength": 1,
          "type": "string"
        },
        "qualifiers": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "second": {
          "maximum": 59,
          "minimum": 0,
          "type": "integer"
        },
        "start_x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "start_y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        "team_id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "pass",
            "cross",
            "throw_in",
            "freekick_crossed",
            "freekick_short",
            "corner_crossed",
            "corner_short",
            "take_on",
            "foul",
            "tackle",
            "interception",
            "shot",
            "shot_penalty",
            "shot_freekick",
            "keeper_save",
            "keeper_claim",
            "keeper_punch",
            "keeper_pick_up",
            "clearance",
            "bad_touch",
            "non_action",
            "dribble",
            "goalkick"
          ],
          "type": "string"
        },
        "under_pressure": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "match_id",
        "possession_id",
        "period",
        "minute",
        "second",
        "team_id",
        "player_id",
        "type",
        "outcome",
        "body_part",
        "start_x",
        "start_y",
        "end_x",
        "end_y",
        "under_pressure",
        "ball_speed_kmh",
        "qualifiers",
        "freeze_frame"
      ],
      "title": "MatchEvent",
      "type": "object"
    },
    "MatchState": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "metrics": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/MetricValue"
            },
            "type": "object"
          },
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "score": {
          "$ref": "#/$defs/Score"
        }
      },
      "required": [
        "schema_version",
        "score",
        "clock",
        "metrics"
      ],
      "title": "MatchState",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "evidence_event_ids"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "Moment": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "evidence_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "importance": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "metrics_after": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricValue"
          },
          "type": "object"
        },
        "metrics_before": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricValue"
          },
          "type": "object"
        },
        "moment_id": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "team": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "moment_id",
        "kind",
        "team",
        "clock",
        "importance",
        "metrics_before",
        "metrics_after",
        "evidence_event_ids"
      ],
      "title": "Moment",
      "type": "object"
    },
    "Overlay": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "evidence_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "match_id": {
          "minLength": 1,
          "type": "string"
        },
        "overlay_id": {
          "minLength": 1,
          "type": "string"
        },
        "priority": {
          "minimum": 0,
          "type": "integer"
        },
        "risk_tier": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "slot": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "aired",
            "expired"
          ],
          "type": "string"
        },
        "t_in": {
          "$ref": "#/$defs/OverlayTime"
        },
        "text": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "values": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "overlay_id",
        "match_id",
        "kind",
        "slot",
        "t_in",
        "duration_ms",
        "priority",
        "risk_tier",
        "text",
        "values",
        "evidence_event_ids",
        "status"
      ],
      "title": "Overlay",
      "type": "object"
    },
    "OverlayTime": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/Clock"
        },
        "wall": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "match",
        "wall"
      ],
      "title": "OverlayTime",
      "type": "object"
    },
    "PlayerPosition": {
      "additionalProperties": false,
      "description": "Facing angle in degrees: 0 points along +x, 90 along +y (anticlockwise).",
      "properties": {
        "facing_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "player_id": {
          "minLength": 1,
          "type": "string"
        },
        "team_id": {
          "minLength": 1,
          "type": "string"
        },
        "x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "player_id",
        "team_id",
        "x",
        "y",
        "facing_deg"
      ],
      "title": "PlayerPosition",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "minimum": 0,
          "type": "integer"
        },
        "home": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "home",
        "away"
      ],
      "title": "Score",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "Insight": {
      "$ref": "#/$defs/Insight"
    },
    "Match": {
      "$ref": "#/$defs/Match"
    },
    "MatchEvent": {
      "$ref": "#/$defs/MatchEvent"
    },
    "MatchState": {
      "$ref": "#/$defs/MatchState"
    },
    "Moment": {
      "$ref": "#/$defs/Moment"
    },
    "Overlay": {
      "$ref": "#/$defs/Overlay"
    }
  },
  "title": "Contracts",
  "type": "object"
}
