{
  "$defs": {
    "LineupPlayer": {
      "additionalProperties": false,
      "description": "One player on the published team sheet (public before kick-off).",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "position": {
          "enum": [
            "GK",
            "RB",
            "RCB",
            "CB",
            "LCB",
            "LB",
            "RWB",
            "LWB",
            "DM",
            "RCM",
            "CM",
            "LCM",
            "RM",
            "LM",
            "AM",
            "RW",
            "LW",
            "ST"
          ],
          "title": "Position",
          "type": "string"
        },
        "shirt_number": {
          "maximum": 99,
          "minimum": 1,
          "title": "Shirt Number",
          "type": "integer"
        },
        "starting": {
          "default": true,
          "title": "Starting",
          "type": "boolean"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "sweeper keeper",
                "ball-playing centre-back",
                "stopper",
                "inverted full-back",
                "overlapping full-back",
                "wing-back",
                "deep-lying playmaker",
                "holding midfielder",
                "box-to-box midfielder",
                "attacking midfielder",
                "inverted winger",
                "touchline winger",
                "poacher",
                "target man",
                "false 9",
                "creative 9",
                "second striker"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "player_id",
        "team_id",
        "name",
        "shirt_number",
        "position"
      ],
      "title": "LineupPlayer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "away_strength": {
      "maximum": 1,
      "minimum": 0,
      "title": "Away Strength",
      "type": "number"
    },
    "away_team": {
      "minLength": 1,
      "title": "Away Team",
      "type": "string"
    },
    "competition": {
      "minLength": 1,
      "title": "Competition",
      "type": "string"
    },
    "home_strength": {
      "maximum": 1,
      "minimum": 0,
      "title": "Home Strength",
      "type": "number"
    },
    "home_team": {
      "minLength": 1,
      "title": "Home Team",
      "type": "string"
    },
    "kickoff": {
      "format": "date-time",
      "title": "Kickoff",
      "type": "string"
    },
    "lineups": {
      "items": {
        "$ref": "#/$defs/LineupPlayer"
      },
      "title": "Lineups",
      "type": "array"
    },
    "match_id": {
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "scenario",
        "free_simulation"
      ],
      "title": "Mode",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "venue": {
      "minLength": 1,
      "title": "Venue",
      "type": "string"
    },
    "weather": {
      "enum": [
        "dry",
        "rain",
        "wind",
        "heat"
      ],
      "title": "Weather",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "match_id",
    "home_team",
    "away_team",
    "venue",
    "kickoff",
    "competition",
    "seed",
    "weather",
    "mode",
    "home_strength",
    "away_strength",
    "lineups"
  ],
  "title": "Match",
  "type": "object"
}
