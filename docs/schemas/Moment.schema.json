{
  "$defs": {
    "Clock": {
      "additionalProperties": false,
      "properties": {
        "minute": {
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        },
        "period": {
          "maximum": 5,
          "minimum": 1,
          "title": "Period",
          "type": "integer"
        },
        "second": {
          "maximum": 59,
          "minimum": 0,
          "title": "Second",
          "type": "integer"
        }
      },
      "required": [
        "period",
        "minute",
        "second"
      ],
      "title": "Clock",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "evidence_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "evidence_event_ids"
      ],
      "title": "MetricValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clock": {
      "$ref": "#/$defs/Clock"
    },
    "evidence_event_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "importance": {
      "maximum": 1,
      "minimum": 0,
      "title": "Importance",
      "type": "number"
    },
    "kind": {
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "metrics_after": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricValue"
      },
      "title": "Metrics After",
      "type": "object"
    },
    "metrics_before": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricValue"
      },
      "title": "Metrics Before",
      "type": "object"
