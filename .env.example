PG_PASSWORD=
# Interpreter store (optional): a full URL overrides the compose Postgres.
# DATABASE_URL=

# Kafka (stream/kafka.py). Local compose needs nothing; for Azure Event Hubs:
# KAFKA_BOOTSTRAP_SERVERS=<namespace>.servicebus.windows.net:9093
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=$ConnectionString
# KAFKA_SASL_PASSWORD=

# Model adapter (agents/llm)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests a minute we allow (set a little under your AI Studio limit).
GEMINI_RPM=10
# Azure AI Foundry (agents/llm/foundry.py): https://<resource>.openai.azure.com
# (or .services.ai.azure.com). Deployments named after their models.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-4.1-mini
FOUNDRY_ANALYST_MODEL=gpt-5-mini

# Kill switch (core/budget.py): a run stops before it would spend more than this.
MAX_RUN_USD=0.50
MAX_RUN_TOKENS=500000
KES_RATE=130
KES_RATE_DATE=2026-09-29
